{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sempersupra.org/secure-messaging/message-envelope-v1.schema.json",
  "title": "Secure Messaging Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "message_id", "message_type", "sender", "target", "created_at", "requires_ack", "body", "artifacts"],
  "properties": {
    "protocol": {"const": "org.sempersupra.secure-messaging.v1"},
    "message_id": {"type": "string", "format": "uuid"},
    "message_type": {"type": "string", "minLength": 1},
    "sender": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": ["string", "null"]},
    "causation_id": {"type": ["string", "null"]},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "requires_ack": {"type": "boolean"},
    "idempotency_key": {"type": ["string", "null"]},
    "body": {"type": "object"},
    "artifacts": {
      "type": "array",
      "items": {"$ref": "artifact-reference-v1.schema.json"}
    }
  }
}
